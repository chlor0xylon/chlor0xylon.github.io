---
import PageLayout from "@/layouts/Base.astro";
import { withBase } from "@/utils/path";

const dataUrl = withBase("/imagenet-graph.json");
---

<PageLayout meta={{ title: "ImageNet hierarchy graph", description: "Interactive view of the WordNet hierarchy condensed onto the 1000 ImageNet classes." }}>
	<section aria-labelledby="graph-title">
		<h1 id="graph-title">ImageNet hierarchy graph</h1>
		<p>
			The WordNet hierarchy condensed onto the 1000 ImageNet classes. Drag to pan, scroll to zoom,
			hover a node to see its label. Node colors come from the spectral embedding described in
			<a href={withBase("/posts/imagenet-hidden-hierarchy/")}>the article</a>.
		</p>
		<input id="graph-search" type="search" list="graph-labels" placeholder="Find a node…" />
		<datalist id="graph-labels"></datalist>
		<div id="graph" data-src={dataUrl} role="img" aria-label="Interactive ImageNet hierarchy graph"></div>
	</section>
</PageLayout>

<style>
	#graph {
		width: 100%;
		height: 70vh;
		margin-top: 0.75rem;
		border: 1px solid hsl(var(--theme-text) / 0.2);
		border-radius: 4px;
	}
	#graph-search {
		width: 100%;
		max-width: 24rem;
		padding: 0.25rem 0.5rem;
		font: inherit;
		color: inherit;
		background: transparent;
		border: 1px solid hsl(var(--theme-text) / 0.3);
		border-radius: 4px;
	}
</style>

<script>
	import Graph from "graphology";
	import Sigma from "sigma";
	import { drawDiscNodeHover } from "sigma/rendering";

	type Payload = {
		nodes: [number, string, number, number, string, boolean][];
		edges: [number, number][];
	};

	const container = document.getElementById("graph") as HTMLElement;
	const search = document.getElementById("graph-search") as HTMLInputElement;
	const labels = document.getElementById("graph-labels") as HTMLDataListElement;

	async function main() {
	const { nodes, edges }: Payload = await (await fetch(container.dataset.src as string)).json();

	const textColor = `hsl(${getComputedStyle(document.documentElement).getPropertyValue("--theme-text")})`;
	const graph = new Graph({ type: "directed" });
	const byLabel = new Map<string, string>();
	for (const [id, label, x, y, color, isClass] of nodes) {
		graph.addNode(String(id), { label, isClass, x, y, color, size: isClass ? 4 : 6 });
		byLabel.set(label, String(id));
		labels.append(new Option(label));
	}
	for (const [source, target] of edges) {
		graph.addEdge(String(source), String(target), { color: "#9998", size: 1 });
	}

	let hovered: string | null = null;
	const renderer = new Sigma(graph, container, {
		labelColor: { color: textColor },
		labelRenderedSizeThreshold: 8,
		// Sigma always draws the hover box in white, so force a dark label on it.
		defaultDrawNodeHover: (context, data, settings) =>
			drawDiscNodeHover(context, data, { ...settings, labelColor: { color: "#000" } }),
		// Only terminal nodes (the ImageNet classes) keep a permanent label; the others show it on hover.
		nodeReducer: (node, data) =>
			node === hovered || data.isClass ? data : { ...data, label: null },
	});

	renderer.on("enterNode", ({ node }) => {
		hovered = node;
		renderer.refresh();
	});
	renderer.on("leaveNode", () => {
		hovered = null;
		renderer.refresh();
	});

	search.addEventListener("change", () => {
		const id = byLabel.get(search.value);
		if (!id) return;
		const { x, y } = renderer.getNodeDisplayData(id) as { x: number; y: number };
		renderer.getCamera().animate({ x, y, ratio: 0.05 }, { duration: 600 });
	});
	}

	main();
</script>
